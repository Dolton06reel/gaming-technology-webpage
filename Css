
/* Type selector */
body {
    font-family: Arial, sans-serif;
    background-color: #f0f4f8;
    color: #243447;
    margin: 0;
    padding: 20px;
}

/* ID selector */
#main-header {
    background-color: #1e3a5f;
    color: white;
    text-align: center;
    padding: 25px;
    margin-bottom: 20px;
    border: 3px solid #f4a261;
}

/* Class selector */
.content-box {
    background-color: white;
    padding: 20px;
    margin: 20px 0;
    border: 2px solid #1e3a5f;
    border-radius: 8px;
}

/* Type selector */
h2 {
    color: #1e3a5f;
    border-bottom: 2px solid #f4a261;
    padding-bottom: 8px;
}

/* Type selector */
p {
    line-height: 1.6;
}

/* Navigation styling */
nav {
    background-color: #f4a261;
    padding: 15px;
    text-align: center;
    margin-bottom: 20px;
}

/* Type selector */
nav a {
    color: #1e3a5f;
    text-decoration: none;
    font-weight: bold;
    margin: 0 15px;
}

/* Hover effect */
nav a:hover {
    color: white;
}

/* Footer styling */
footer {
    background-color: #1e3a5f;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: 20px;
    border: 2px solid #f4a261;
}
